# Owned by ansible; applied by the k3s helm-controller to the bundled traefik release.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      spec:
        type: NodePort
    ports:
      web:
        nodePort: 30080
      websecure:
        nodePort: 30443
    # NodePort has no load balancer address, so Ingress status stays empty and Argo
    # would report it Progressing forever. Publish the node address instead.
    providers:
      kubernetesIngress:
        publishedService:
          enabled: false
    additionalArguments:
      - "--providers.kubernetesingress.ingressendpoint.ip={{ k3s_ip }}"
