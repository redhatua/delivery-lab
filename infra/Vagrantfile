# Two VMs on a private network. Sizing and boxes come from settings.yaml.
# The provider is chosen by scripts/lib.sh (libvirt on Linux and WSL2, VirtualBox on Intel
# Macs, VMware Fusion on Apple Silicon); LAB_PROVIDER overrides it.
require 'yaml'

cfg = YAML.load_file(File.join(__dir__, 'settings.yaml'))
provider = ENV.fetch('LAB_PROVIDER', 'libvirt')
box = cfg['boxes'][provider] or abort("no box defined for provider #{provider}")

Vagrant.configure('2') do |config|
  config.vm.box = box['name']
  config.vm.box_version = box['version']
  config.vm.synced_folder '.', '/vagrant', disabled: true
  config.ssh.insert_key = true

  cfg['vms'].each do |name, vm|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network :private_network,
        ip: vm['ip'],
        libvirt__network_name: cfg['network']['name'],
        libvirt__forward_mode: 'nat',
        libvirt__dhcp_enabled: false
      node.vm.provider :libvirt do |lv|
        lv.driver = 'kvm'
        lv.uri = 'qemu:///system'
        lv.cpus = vm['cpus']
        lv.memory = vm['memory_mb']
        lv.machine_virtual_size = vm['disk_gb']
        lv.default_prefix = "#{cfg['lab_name']}_"
      end
      node.vm.provider :virtualbox do |vb|
        vb.name = "#{cfg['lab_name']}_#{name}"
        vb.cpus = vm['cpus']
        vb.memory = vm['memory_mb']
      end
      node.vm.provider :vmware_desktop do |v|
        v.gui = false
        v.vmx['displayname'] = "#{cfg['lab_name']}_#{name}"
        v.vmx['numvcpus'] = vm['cpus'].to_s
        v.vmx['memsize'] = vm['memory_mb'].to_s
      end
      node.vm.provider :parallels do |p|
        p.name = "#{cfg['lab_name']}_#{name}"
        p.cpus = vm['cpus']
        p.memory = vm['memory_mb']
      end
    end
  end
end
